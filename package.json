{
  "name": "elham-mirzakhani-law-office",
  "private": true,
  "version": "1.0.0",
  "description": "وب‌سایت رسمی دفتر وکالت الهام میرزاخانی، وکیل پایه یک دادگستری در شهرکرد",
  "author": "Mohammad Mirzakhani",
  "type": "module",
  "scripts": {
